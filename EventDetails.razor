@page "/events/{EventId:int}"
@inject EventService EventService
@inject AttendanceService AttendanceService
@inject NavigationManager Navigation

<PageTitle>@(SelectedEvent?.Title ?? "Event Details") — EventEase</PageTitle>

@if (SelectedEvent is null)
{
    <div class="not-found-card">
        <h2>Event Not Found</h2>
        <p>No event matches ID #@EventId.</p>
        <a class="btn btn-primary" href="/">Back to Events</a>
    </div>
}
else
{
    <div class="details-card">
        <h1>@SelectedEvent.Title</h1>
        <p class="event-meta"><strong>Date:</strong> @SelectedEvent.Date.ToString("dddd, MMMM dd, yyyy")</p>
        <p class="event-meta"><strong>Location:</strong> @SelectedEvent.Location</p>
        <p class="event-meta">
            <strong>Seats Reserved:</strong>
            @AttendanceService.GetTotalTicketsForEvent(SelectedEvent.Id) of @SelectedEvent.Capacity
        </p>
        <hr />
        <p>@SelectedEvent.Description</p>

        <div class="card-actions">
            <a class="btn btn-primary" href="/register/@SelectedEvent.Id">Register for Event</a>
            <a class="btn btn-secondary" href="/">Back to All Events</a>
        </div>
    </div>
}

@code {
    [Parameter]
    public int EventId { get; set; }

    private Event? SelectedEvent { get; set; }

    protected override void OnParametersSet()
    {
        SelectedEvent = EventService.GetEventById(EventId);
    }
}
